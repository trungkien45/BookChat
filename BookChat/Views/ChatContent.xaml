<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BookChat.Views.ChatContent" BindingContext="this">
    <Grid RowDefinitions="Auto,*">

        <Picker x:Name="pickerProviderr" Grid.Row="0" Title="Chat"  ItemsSource="{Binding Providers}"
                ItemDisplayBinding="{Binding Name}" BackgroundColor="White"
                SelectedItem="{Binding SelectedProvider}" />

        <WebView x:Name="xWebChat"
            Grid.Row="1"/>
    </Grid>
</ContentView>
