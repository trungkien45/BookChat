<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BookChat.Views.NoteContent"
             xmlns:res="clr-namespace:BookChat.Resources"
             xmlns:models="clr-namespace:BookChat.Models"
             x:Name="thisControl">
    <Grid RowDefinitions="Auto, *">

        <!-- Header Bar with Title & Add Button -->
        <Grid Grid.Row="0" 
              ColumnDefinitions="*, Auto" 
              Padding="12, 10" 
              BackgroundColor="#2D2D30">

            <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                <Label Text="🔖" FontSize="16" VerticalOptions="Center"/>
                <Label Text="{x:Static res:AppResources.NoteListTitle}" 
                       TextColor="#E1E1E1" 
                       FontAttributes="Bold" 
                       FontSize="14" 
                       VerticalOptions="Center"/>
            </HorizontalStackLayout>

            <!-- Add Note Button -->
            <Button x:Name="BtnAddNote"
                    Grid.Column="1"
                    Text="{x:Static res:AppResources.AddButton}"
                    FontSize="12"
                    FontAttributes="Bold"
                    TextColor="White"
                    BackgroundColor="#512BD4"
                    CornerRadius="6"
                    HeightRequest="32"
                    Padding="12,0"
                    Clicked="OnAddNoteClicked"/>
        </Grid>

        <!-- Notes List -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Notes}"
                        SelectionMode="None">

            <!-- Empty State View -->
            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center" 
                                     HorizontalOptions="Center" 
                                     Spacing="12" 
                                     Padding="20">
                    <Label Text="🔖" 
                           FontSize="40" 
                           HorizontalOptions="Center" 
                           Opacity="0.6" />
                    <Label Text="{x:Static res:AppResources.NoNotesYet}" 
                           TextColor="#ACACAC" 
                           FontSize="14" 
                           FontAttributes="Bold"
                           HorizontalOptions="Center" />
                    <Label Text="{x:Static res:AppResources.NoNotesDetail}" 
                           TextColor="#6E6E6E" 
                           FontSize="12" 
                           HorizontalTextAlignment="Center"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <!-- Note Item Template -->
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Note">
                    <SwipeView Margin="0, 4">
                        <!-- Right Swipe Actions for Touch/Mobile -->
                        <SwipeView.RightItems>
                            <SwipeItems Mode="Reveal">
                                <SwipeItem x:Name="SwipeEdit"
                                           Text="{x:Static res:AppResources.Edit}" 
                                           BackgroundColor="#512BD4" 
                                           IconImageSource="{FontImageSource Glyph='✏️', Color=White, Size=16}"
                                           Invoked="OnEditNoteClicked"/>
                                <SwipeItem x:Name="SwipeDelete"
                                           Text="{x:Static res:AppResources.MenuDelete}" 
                                           BackgroundColor="#E53935" 
                                           IconImageSource="{FontImageSource Glyph='🗑️', Color=White, Size=16}"
                                           Invoked="OnDeleteNoteClicked"/>
                            </SwipeItems>
                        </SwipeView.RightItems>

                        <Border StrokeShape="RoundRectangle 8"
                                Stroke="#33FFFFFF"
                                StrokeThickness="1"
                                BackgroundColor="#252526"
                                Padding="10, 8">

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnNoteItemTapped"/>
                            </Border.GestureRecognizers>

                            <!-- Context Menu for Mouse Right-Click / Long-Press -->
                            <FlyoutBase.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem x:Name="MfiEdit"
                                                    Text="{x:Static res:AppResources.EditNote}"
                                                    Clicked="OnEditNoteClicked"/>
                                    <MenuFlyoutItem x:Name="MfiDelete"
                                                    Text="{x:Static res:AppResources.DeleteNote}"
                                                    Clicked="OnDeleteNoteClicked"/>
                                </MenuFlyout>
                            </FlyoutBase.ContextFlyout>

                            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="10" VerticalOptions="Center">

                                <!-- Prominent Page Number Badge -->
                                <Border Grid.Column="0"
                                        StrokeShape="RoundRectangle 6"
                                        BackgroundColor="#3E2723"
                                        Stroke="#FFAB91"
                                        StrokeThickness="1"
                                        Padding="8, 4"
                                        VerticalOptions="Center">
                                    <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                        <Label Text="📄" FontSize="11" VerticalOptions="Center"/>
                                        <Label Text="{Binding PageNumber, StringFormat={x:Static res:AppResources.PageFormat}}" 
                                               TextColor="#FFAB91" 
                                               FontAttributes="Bold" 
                                               FontSize="12" 
                                               VerticalOptions="Center"/>
                                    </HorizontalStackLayout>
                                </Border>

                                <!-- Note Content / Title -->
                                <Label Grid.Column="1"
                                       Text="{Binding Content}"
                                       TextColor="White"
                                       FontSize="13"
                                       LineBreakMode="TailTruncation"
                                       VerticalOptions="Center"/>

                                <!-- Context Menu Indicator Button -->
                                <Label Grid.Column="2"
                                       Text="⋮"
                                       TextColor="#ACACAC"
                                       FontSize="16"
                                       WidthRequest="28"
                                       HorizontalTextAlignment="Center"
                                       VerticalOptions="Center">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnNoteOptionsClicked"/>
                                    </Label.GestureRecognizers>
                                </Label>
                            </Grid>
                        </Border>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>
    </Grid>
</ContentView>
