<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BookChat.MainPage">

    <ContentPage.ToolbarItems>
        <!-- Use a raster/vector image placed in Resources/Images named 'gear.png' (or gear.svg) -->
        <ToolbarItem IconImageSource="gear.png" Clicked="OnSettingsClicked" Priority="0" Order="Primary" />
    </ContentPage.ToolbarItems>

    <Grid x:Name="MainGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Primary pane -->
        <ScrollView Grid.Column="0" x:Name="PrimaryScroll">
            <VerticalStackLayout Padding="10" Spacing="8">
                <Label x:Name="LibPathLabel" FontAttributes="Bold" />
                <Label x:Name="BreadcrumbLabel" FontSize="12" TextColor="Gray" />
                <StackLayout x:Name="FilesStack" Spacing="4" />
            </VerticalStackLayout>
        </ScrollView>

        <!-- Secondary pane (split view). Initially hidden. -->
        <ScrollView Grid.Column="1" x:Name="SecondaryScroll" IsVisible="False" BackgroundColor="Transparent">
            <VerticalStackLayout Padding="10" Spacing="8">
                <Label x:Name="SecondaryBreadcrumbLabel" FontSize="12" TextColor="Gray" />
                <StackLayout x:Name="SecondaryFilesStack" Spacing="4" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
