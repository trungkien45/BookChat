<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BookChat.MainPage">

    <ContentPage.ToolbarItems>
        <!-- Use a raster/vector image placed in Resources/Images named 'gear.png' (or gear.svg) -->
        <ToolbarItem IconImageSource="gear.png" Clicked="OnSettingsClicked" Priority="0" Order="Primary" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="10" Spacing="8">
            <Label x:Name="LibPathLabel" FontAttributes="Bold" />
            <StackLayout x:Name="FilesStack" Spacing="4" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
